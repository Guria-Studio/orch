# orch estimate against the parity fixture: F2.T2 is in-progress, which a new
# run re-dispatches; F2.T3 is blocked and never dispatches; the rest is done.
# The fixture has no spend, so the numbers are the stated defaults.
exec orch estimate --project-root proj --project-id parity-project
stdout '^≈ 1 task · ≈ \$[0-9.]+ \(claude \$[0-9.]+\) · ≈ 10m with 4 slots \(critical path 10m\)$'
stdout '^no history yet — rough'

exec orch estimate --json --project-root proj --project-id parity-project
stdout '"tasks":\["F2\.T2"\]'
stdout '"confidence":"none"'

# --only narrows like run's.
exec orch estimate --only 'F0*' --project-root proj --project-id parity-project
stdout '^≈ 0 tasks'
! stdout 'backlog'

# Backlog never dispatches; with nothing else to run, the estimate says how to
# promote it (#579), and --json lists it.
exec orch estimate --project-root backlog-proj
stdout '^≈ 0 tasks: nothing is ready to run'
stdout '^1 task in backlog is not dispatched — promote it with: orch task set --id B-1 --status todo$'
exec orch estimate --json --project-root backlog-proj
stdout '"backlog":\["B-1"\]'
-- backlog-proj/tasks.json --
{"tasks":[{"id":"B-1","phase":1,"title":"b one","model":"claude/haiku","status":"backlog","dependencies":[],"estimateHours":1.0,"files":[],"specRef":""}]}
-- backlog-proj/.orchestrator/model_router.yaml --
claude/haiku:
  backend: claude
  cli_model: claude-haiku-4-5
  tier: cheap
  is_premium: false
-- backlog-proj/scripts/task-start.sh --
#!/bin/sh
exit 0

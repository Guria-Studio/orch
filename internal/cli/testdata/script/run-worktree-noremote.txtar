# `orch run` in worktree mode with auto-PR on, in a repository with no remote
# — what `git init` and `orch init` leave (#376). The work stays on the
# task's local branch and the task finishes; it used to block on a push that
# could not work.

[!exec:git] skip

env ORCH_FAKE_PROVIDER=$WORK/fake
cd $WORK/wtproj
exec git init -q --initial-branch=main .
exec git config user.email orch@example.com
exec git config user.name orch
exec git config commit.gpgsign false
exec git add -A
exec git commit -q -m 'initial'

exec orch run --project-root $WORK/wtproj --skip-update-check
stderr 'no git remote — each task''s work stays on its local orch/<task-id> branch'
! stderr 'push failed'
exec orch tasks --project-root $WORK/wtproj --json
stdout '"status":"done"'
exec git branch --list orch/T-1
stdout 'orch/T-1'

-- wtproj/tasks.json --
{"tasks":[{"id":"T-1","phase":1,"title":"do the thing","model":"claude/haiku","status":"todo","dependencies":[],"estimateHours":1.0,"files":[],"specRef":"","reason":"because"}]}
-- wtproj/.orchestrator/config.yaml --
dispatch:
  worktree_mode: true
  base_branch: main
vcs:
  provider: github
  auto_pr: true
-- wtproj/.orchestrator/model_router.yaml --
claude/haiku:
  backend: claude
  cli_model: claude-haiku-4-5
  tier: cheap
  is_premium: false
-- wtproj/scripts/task-start.sh --
#!/bin/sh
exec orch task-status "$1" in-progress
-- wtproj/scripts/task-finish.sh --
#!/bin/sh
exec orch task-status "$1" done
-- fake/claude/_default.out --
{"type":"result","subtype":"success","is_error":false,"total_cost_usd":0,"usage":{"input_tokens":1,"output_tokens":1}}

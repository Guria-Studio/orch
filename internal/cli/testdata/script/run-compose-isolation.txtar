# #343: two tasks in sibling worktrees share one docker compose project unless
# something tells them apart, and one task's `docker compose up` then recreates
# the containers another is testing against. A real `orch run` hands both
# dispatch.worktree_setup and the dispatched child the task's own compose
# project and slot, replacing whatever the operator's shell exported.
#
# bin/sleep stands in for the fake provider's first command, run by the child
# itself in its worktree, and writes down what it was given.

[!exec:git] skip
[!exec:sh] skip

chmod 0755 $WORK/bin/sleep
env PATH=$WORK/bin:$PATH
env ORCH_FAKE_PROVIDER=$WORK/fake
env CHILD_OUT=$WORK/child
env COMPOSE_PROJECT_NAME=shared
mkdir $WORK/child

cd $WORK/wtproj
exec git init --initial-branch=main .
exec git config user.email orch@example.com
exec git config user.name orch
exec git config commit.gpgsign false
exec git add -A
exec git commit -q -m 'initial'

exec orch run --no-push

cmp $WORK/child/setup-env $WORK/want-env
cmp $WORK/child/agent-env $WORK/want-env

-- want-env --
wtproj-t-1|1|T-1
-- wtproj/tasks.json --
{"tasks":[{"id":"T-1","phase":1,"title":"do the thing","model":"claude/haiku","status":"todo","dependencies":[],"estimateHours":1.0,"files":[],"specRef":"specs/a.md#T1","reason":"because"}]}
-- wtproj/.orchestrator/config.yaml --
concurrency:
  global_max: 1
  per_provider:
    claude: 1
dispatch:
  worktree_mode: true
  base_branch: main
  worktree_setup: printf '%s|%s|%s\n' "$COMPOSE_PROJECT_NAME" "$ORCH_TASK_SLOT" "$ORCH_TASK_ID" > "$CHILD_OUT/setup-env"
vcs:
  auto_pr: false
-- wtproj/.orchestrator/model_router.yaml --
claude/haiku:
  backend: claude
  cli_model: claude-haiku-4-5
  tier: cheap
  is_premium: false
-- wtproj/scripts/task-start.sh --
#!/bin/sh
exec orch task-status "$1" in-progress
-- wtproj/scripts/task-finish.sh --
#!/bin/sh
exec orch task-status "$1" done
-- fake/claude/_default.out --
{"type":"result","subtype":"success","is_error":false,"total_cost_usd":0,"usage":{"input_tokens":1,"output_tokens":1}}
-- bin/sleep --
#!/bin/sh
# The fake provider's first command, run by the dispatched child itself.
printf '%s|%s|%s\n' "$COMPOSE_PROJECT_NAME" "$ORCH_TASK_SLOT" "$ORCH_TASK_ID" > "$CHILD_OUT/agent-env"
exit 0

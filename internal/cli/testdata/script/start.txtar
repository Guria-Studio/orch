# `orch start` (#377): from an idea to a checked, estimated plan. claude is a
# fake that records how it was called and writes the plan; PATH holds it, orch
# and the system tools, so no real AI CLI is found.
chmod 0755 bin/claude
chmod 0755 bin/codex
chmod 0755 codexonly/codex
env FAKE_PLAN=$WORK/plan.json

# No AI CLI at all: nothing to plan or run with.
env PATH=$ORCH_BIN_DIR:/usr/bin:/bin
exec git init -q bare
cd bare
! exec orch start --no-run 'a todo app'
stderr 'no AI CLI on PATH'
cd $WORK

# Not a git repository: each task needs a branch.
env PATH=$WORK/bin:$ORCH_BIN_DIR:/usr/bin:/bin
mkdir nogit
cd nogit
! exec orch start --no-run 'a todo app'
stderr 'not a git repository'
cd $WORK

# A fresh repository: scaffolded with models of the installed CLIs, skills
# installed, claude asked to plan the idea, and the task routed to codex
# moved to claude, which is the only one here.
exec git init -q fresh
cd fresh
exec orch start --no-run 'a todo app'
stdout '^✓ claude, codex on PATH · git repository$'
stdout 'orch project created in .*fresh \(premium claude/claude-opus-4-7 · standard claude/claude-sonnet-4-6 · cheap claude/claude-haiku-4-5\)'
stdout 'Claude agents are refused orch''s own tools'
stdout '^✓ installed claude skills: .*orch-plan'
stdout '^→ claude plans it with /orch-plan'
grep -count=1 '^/orch-plan a todo app$' $HOME/claude-args
stdout '^↪ T2: opencode/glm-5.2 → claude/claude-sonnet-4-6 \(opencode is not on PATH\)$'
! stdout 'T1:'
stdout '^✓ tasks.json: 2 tasks, DAG valid, every model routed$'
stdout '^≈ 2 tasks · '
stdout '^Next: orch run --max-tasks 2$'
grep '"model": "claude/claude-sonnet-4-6"' tasks.json
! grep 'opencode/glm-5.2' tasks.json
grep 'enabled: false' .orchestrator/config.yaml
stdout '^✓ no git remote: agents work in this directory'
grep '^  worktree_mode: false' .orchestrator/config.yaml
grep '^  auto_pr: false' .orchestrator/config.yaml

# Again, with tasks already there: no planning, and the skills are left as
# they are.
exec orch start --no-run 'another idea'
stdout 'tasks.json already has 2 tasks: planning skipped'
! stdout 'installed claude skills'
grep -count=1 'orch-plan' $HOME/claude-args

# --replan plans again; with no idea, from the repository itself.
exec orch start --no-run --replan
grep -count=2 'orch-plan' $HOME/claude-args
grep '^/orch-plan plan the next work for this repository' $HOME/claude-args
cd $WORK

# claude exits without writing a task: nothing to check or run.
env FAKE_PLAN=$WORK/empty-plan.json
exec git init -q noplan
cd noplan
! exec orch start --no-run 'a todo app'
stderr 'claude finished without writing tasks to tasks.json'
cd $WORK
env FAKE_PLAN=$WORK/plan.json

# --yes runs the first tasks, with the dashboard up meanwhile: the plan's two
# tasks go through the fake provider and end done. Not on a terminal, the
# dashboard stops with the run instead of waiting for Ctrl-C.
env ORCH_FAKE_PROVIDER=$WORK/fake
exec git init -q runs
cd runs
exec orch start --yes 'a todo app'
stdout 'Added mcp__orch'
stdout '^→ dashboard: http://127\.0\.0\.1:[0-9]+$'
! stdout 'keeps serving'
exec orch tasks --json
stdout '"id":"T1"[^}]*"status":"done"'
stdout '"id":"T2"[^}]*"status":"done"'
cd $WORK

# codex alone can run tasks but cannot plan: planning needs claude.
env PATH=$WORK/codexonly:$ORCH_BIN_DIR:/usr/bin:/bin
exec git init -q nocl
cd nocl
! exec orch start --no-run 'a todo app'
stderr 'planning needs claude'

-- bin/claude --
#!/bin/sh
echo "$*" >> "$HOME/claude-args"
cp "$FAKE_PLAN" tasks.json
-- bin/codex --
#!/bin/sh
exit 0
-- codexonly/codex --
#!/bin/sh
exit 0
-- empty-plan.json --
{"meta":{},"phases":[],"tasks":[]}
-- fake/claude/_default.out --
{"type":"result","subtype":"success","is_error":false,"total_cost_usd":0,"usage":{"input_tokens":1,"output_tokens":1}}
-- plan.json --
{"meta":{},"phases":[],"tasks":[
  {"id":"T1","phase":1,"title":"Todo model","model":"claude/claude-haiku-4-5","status":"todo","dependencies":[],"estimateHours":1.0,"files":[],"specRef":""},
  {"id":"T2","phase":1,"title":"Todo API","model":"opencode/glm-5.2","status":"todo","dependencies":["T1"],"estimateHours":1.0,"files":[],"specRef":""}
]}
